{
    // Windows MSYS2/MinGW64 Configuration for MLIR Tutorial
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell",
            "env": {
                "PATH": "${env:PATH};C:\\msys64\\mingw64\\bin;C:\\msys64\\usr\\bin"
            }
        },
        "MSYS2 MINGW64": {
            "path": "C:\\msys64\\usr\\bin\\bash.exe",
            "args": ["--login", "-i"],
            "env": {
                "MSYSTEM": "MINGW64",
                "CHERE_INVOKING": "1"
            },
            "icon": "terminal-linux"
        },
        "MSYS2 MSYS": {
            "path": "C:\\msys64\\usr\\bin\\bash.exe",
            "args": ["--login", "-i"],
            "env": {
                "MSYSTEM": "MSYS",
                "CHERE_INVOKING": "1"
            },
            "icon": "terminal-bash"
        }
    },

    // MLIR Language Server Configuration
    "mlir.server_path": "C:\\msys64\\mingw64\\bin\\mlir-lsp-server.exe",
    "mlir.opt_path": "C:\\msys64\\mingw64\\bin\\mlir-opt.exe",
    "mlir.translate_path": "C:\\msys64\\mingw64\\bin\\mlir-translate.exe",

    // LLVM Tools Configuration
    "llvm-vs-code-extensions.llc": "C:\\msys64\\mingw64\\bin\\llc.exe",
    "llvm-vs-code-extensions.lli": "C:\\msys64\\mingw64\\bin\\lli.exe",
    "llvm-vs-code-extensions.opt": "C:\\msys64\\mingw64\\bin\\opt.exe",

    // CMake Configuration
    "cmake.cmakePath": "C:\\msys64\\mingw64\\bin\\cmake.exe",
    "cmake.generator": "Ninja",
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.configureArgs": [
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DMLIR_DIR=C:/msys64/mingw64/lib/cmake/mlir",
        "-DLLVM_DIR=C:/msys64/mingw64/lib/cmake/llvm"
    ],

    // C++ Configuration
    "C_Cpp.default.compilerPath": "C:\\msys64\\mingw64\\bin\\g++.exe",
    "C_Cpp.default.cStandard": "c17",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/**",
        "C:/msys64/mingw64/include",
        "C:/msys64/mingw64/lib/clang/*/include"
    ],

    // File Associations
    "files.associations": {
        "*.mlir": "mlir",
        "*.ll": "llvm",
        "*.td": "tablegen"
    },

    // Editor Settings
    "files.eol": "\n",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,

    // Exclude build artifacts from search
    "search.exclude": {
        "**/build/**": true,
        "**/cmake-build-*/**": true,
        "**/.git": true
    },

    // File watcher exclusions
    "files.watcherExclude": {
        "**/build/**": true,
        "**/cmake-build-*/**": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/externals/**": true
    }
}
